# THE BRIDGE — the ONLY crosswalk between the three vocabularies.
#
# A required UX feature is ADMITTED only if the library actually supports its realizer. That is what
# makes the toolkit swappable: change which capabilities the library node offers and the same business
# and UX blocks retarget, or honestly fail to.

fn admit_highlight(c: wants_highlight) -> admitted_cart:
    INVOKE R(lib) related node=F(c) label="library"
    INVOKE R(cap) slot_of node=R(lib) key="styled_label"
    JMPNOT R(cap) .unsupported
    INVOKE R(_) set_slot node=F(c) key="admitted_highlighted_discount" value=true
    JMP .done
.unsupported:
    INVOKE R(_) set_slot node=F(c) key="unsupported_highlighted_discount" value=true
.done:
    INVOKE R(_) set_slot node=F(c) key="highlight_considered" value=true

fn admit_confirmation(c: wants_confirmation) -> admitted_cart:
    INVOKE R(lib) related node=F(c) label="library"
    INVOKE R(cap) slot_of node=R(lib) key="modal_confirm"
    JMPNOT R(cap) .unsupported
    INVOKE R(_) set_slot node=F(c) key="admitted_confirmation_step" value=true
    JMP .done
.unsupported:
    INVOKE R(_) set_slot node=F(c) key="unsupported_confirmation_step" value=true
.done:
    INVOKE R(_) set_slot node=F(c) key="confirmation_considered" value=true
