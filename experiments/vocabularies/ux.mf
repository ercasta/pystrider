# THE UX VOCABULARY — knows about benefits, obligations and what must be surfaced.
# Knows nothing of discounts' arithmetic, and nothing of any widget toolkit.

# A benefit the business granted is something the interface must SURFACE, prominently.
fn surface_benefit(c: discounting_cart) -> ux_specified_cart:
    SET F(c) "requires_highlighted_discount" true

# An IRREVERSIBLE action carries an OBLIGATION to confirm — a modality, not a flag.
fn oblige_confirmation(c: irreversible_cart) -> ux_specified_cart:
    SET F(c) "requires_confirmation_step" true
