# THE BUSINESS VOCABULARY — knows about carts, tiers and money. Knows nothing of screens or widgets.
#
# ⚠ These were CNL rules that FIRED wherever the world matched:
#     ?cart grants_discount yes when ?cart customer_tier premium and ?cart order_qualifies yes
# Microfunctions are POINTED, so nothing fires. What replaces the rule's condition is its PARAMETER
# TYPE: `grant_discount(c: qualified_cart)` is proposable only against a cart that already qualifies.
# The chain the old engine found by saturation, the planner finds by chaining types.

fn qualify_order(c: priced_cart) -> checked_cart:
    INVOKE R(a) slot_of node=F(c) key="amount"
    INVOKE R(p) related node=F(c) label="policy"
    INVOKE R(t) slot_of node=R(p) key="threshold"
    LT R(under) R(a) R(t)
    JMPIF R(under) .no
    INVOKE R(_) set_slot node=F(c) key="order_qualifies" value=true
    JMP .done
.no:
    INVOKE R(_) set_slot node=F(c) key="order_qualifies" value=false
.done:
    INVOKE R(_) set_slot node=F(c) key="order_checked" value=true

fn grant_discount(c: qualified_cart) -> discounting_cart:
    INVOKE R(tier) slot_of node=F(c) key="customer_tier"
    EQ R(premium) R(tier) "premium"
    JMPNOT R(premium) .done
    INVOKE R(_) set_slot node=F(c) key="grants_discount" value=true
    INVOKE R(_) set_slot node=F(c) key="has_benefit_discount" value=true
.done:
    INVOKE R(_) set_slot node=F(c) key="tier_checked" value=true
